<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mentora.Core\Mentora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <!-- Exercise catalog CSV exports read by CatalogSeeder. Explicit LogicalName so the resource
       names do not depend on the folder-to-namespace mangling rules. -->
  <ItemGroup>
    <EmbeddedResource Include="Seeding\Catalog\EXERCICES.csv" LogicalName="Mentora.Catalog.EXERCICES.csv" />
    <EmbeddedResource Include="Seeding\Catalog\MATERIELS.csv" LogicalName="Mentora.Catalog.MATERIELS.csv" />
    <EmbeddedResource Include="Seeding\Catalog\MUSCLES.csv" LogicalName="Mentora.Catalog.MUSCLES.csv" />
    <EmbeddedResource Include="Seeding\Catalog\EXERCICES_MUSCLES.csv" LogicalName="Mentora.Catalog.EXERCICES_MUSCLES.csv" />
    <!-- Lot 12.2a: closed reference lists and the one-time free-text normalization map. -->
    <EmbeddedResource Include="Seeding\Catalog\EXERCISE_REFERENCES.csv" LogicalName="Mentora.Catalog.EXERCISE_REFERENCES.csv" />
    <EmbeddedResource Include="Seeding\Catalog\REFERENCE_VALUE_MAP.csv" LogicalName="Mentora.Catalog.REFERENCE_VALUE_MAP.csv" />
  </ItemGroup>

  <!-- Quiz question sheet export read by QuizQuestionSeeder. -->
  <ItemGroup>
    <EmbeddedResource Include="Seeding\Quiz\QUESTIONS.csv" LogicalName="Mentora.Quiz.QUESTIONS.csv" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
