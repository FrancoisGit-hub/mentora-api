<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.33" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les records de l'API sont lus par réflexion (System.Text.Json) : le linker ne doit pas les élaguer. -->
    <TrimmerRootAssembly Include="Mentora.Admin" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config locale de développement : jamais dans le dossier publié. -->
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
