        await SetActiveAsync(false);
    }

    private async Task SetActiveAsync(bool target)
    {
        if (_detail is null || _currentId is not { } id)
            return;

        _activating = true;
        _actionAlert = null;
        _flash = null;
        try
        {
            var result = await Api.SetActivationAsync(id, target);
            if (result.IsSuccess && result.Data is { } updated)
            {
                // Seuls l'état et l'usage changent : les saisies en cours restent intactes.
                _detail = _detail with { IsActive = updated.IsActive, Usage = updated.Usage, UpdatedDate = updated.UpdatedDate };
                _flash = target ? "Exercice activé." : "Exercice désactivé.";
            }
            else if (result.Status == 409 && result.Error == "EXERCISE_IN_USE")
            {
                _actionAlert = ExerciseText.InUseMessage(result.Details);
            }
            else if (result.Status == 404)
            {
                _notFound = true;
            }
            else
            {
                _actionAlert = ExerciseText.Failure(result);
            }
        }
        finally
        {
            _activating = false;
        }
    }

