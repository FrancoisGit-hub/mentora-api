    private Task OnBeforeNavigation(LocationChangingContext context)
    {
        // Un envoi de vidéo en cours est demandé en premier ; les modifications non enregistrées
        // passent ensuite par leur propre question (la navigation est relancée après l'annulation).
        if (_uploading)
        {
            context.PreventNavigation();
            _pendingTarget = context.TargetLocation;
            _showLeaveUpload = true;
            return Task.CompletedTask;
        }

        if (!IsDirty)
            return Task.CompletedTask;

        context.PreventNavigation();
        _pendingTarget = context.TargetLocation;
        _showLeave = true;
        return Task.CompletedTask;
    }

