{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=mentora_dev;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "dev-secret-key-minimum-32-characters-long",
    "Issuer": "mentora-api",
    "Audience": "mentora-app",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "RefreshTokenPurge": {
    "CountOnly": true,
    "InitialDelayMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "contact@mentorapp.fr",
    "FromDisplayName": "Mentora",
    "Smtp": {
      "Host": "smtp.ionos.fr",
      "Port": 587,
      "UseStartTls": true,
      "Username": "contact@mentorapp.fr",
      "Password": ""
    },
    "Retry": {
      "MaxAttempts": 2,
      "DelaySeconds": 2
    }
  },
  "LiveKit": {
    "Url": "wss://livekit.mentorapp.fr",
    "ApiKey": "",
    "ApiSecret": "",
    "JoinBeforeMinutes": 15,
    "JoinAfterEndMinutes": 15
  },
  "Quiz": {
    "QuestionCount": 12,
    "SessionLifetimeMinutes": 120,
    "AnonymousPermitLimit": 30,
    "AnonymousWindowMinutes": 10
  },

  "AdminAuth": {
    "JwtSecret": "",
    "JwtIssuer": "mentora-admin",
    "JwtAudience": "mentora-admin",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 12,
    "OtpLifetimeMinutes": 10,
    "OtpMaxAttempts": 5,
    "RequestPermitLimit": 30,
    "RequestWindowMinutes": 15,
    "Emails": ""
  }
}
